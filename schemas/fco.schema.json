{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mend.example/schemas/fco.schema.json",
  "title": "Mend Fractal Custody Object",
  "type": "object",
  "required": ["fco_id", "fco_type", "content_sha256", "canonicalization", "execution_state"],
  "properties": {
    "fco_id": {"type": "string", "pattern": "^fco_[0-9a-f]{64}$"},
    "fco_type": {"type": "string"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonicalization": {"const": "RFC8785-like JSON: UTF-8, sorted keys, separators comma/colon, ensure_ascii=false"},
    "parent_fco_ids": {"type": "array", "items": {"type": "string"}},
    "source_ref": {}, "source_date": {}, "retrieval_time": {}, "creation_time": {},
    "freshness_days": {}, "freshness_class": {"enum": ["FRESH", "OLDER_BUT_RELEVANT", "HISTORICAL", "UNKNOWN_DATE", "NULL"]},
    "rights_class": {}, "sensitivity_class": {}, "purpose": {}, "transformation": {},
    "executor": {}, "provider": {}, "model_id": {}, "model_version": {}, "inference_profile": {},
    "prompt_sha256": {}, "parameters_sha256": {}, "input_sha256": {},
    "execution_state": {"enum": ["PROPOSED", "IMPLEMENTED", "EXECUTED", "OBSERVED", "SUPPORTED", "FAILED", "NEGATIVE", "NULL", "DEFERRED", "NOT_TESTED", "UNKNOWN", "NOT_COMPUTED"]},
    "execution_started": {}, "execution_finished": {}, "latency_ms": {}, "result_sha256": {},
    "verification_state": {}, "release_state": {}, "policy_ref": {},
    "provenance_refs": {"type": "array"}, "breakpoint_ref": {}, "payload": {}
  },
  "additionalProperties": true
}
